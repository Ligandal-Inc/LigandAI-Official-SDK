    {
      "operation": "hswae.v2.resolve_cell_type",
      "title": "H-SWAEV2 cell-type resolution",
      "description": "Resolve a cell-type phrase against the FIXED HPA v25 single-cell vocabulary (~202 labels from hpa_v25_single_cell_cluster plus the specialized reference contexts) — not an open Cell Ontology, so an ontology-style phrasing may need the returned nearest_candidates to pick a label. Returns resolution_status, the resolution_stage that matched, always-populated nearest_candidates, unresolved_reason, and the vocabulary scope actually searched. resolution_status: \"unresolved\" means the phrase missed the vocabulary; it is never evidence that the cell type is absent from the atlas.",
      "domain": "transcriptomics",
      "effect": "read_local",
      "executionMode": "immediate",
      "requiredEntitlements": [
        "transcriptomics.hswae2"
      ],
